{
  "name": "@pgmem/core",
  "version": "1.18.0",
  "description": "In-memory PostgreSQL 18 for tests: one DATABASE_URL per test file, reset in place per test, no Docker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shibukawa/pgmem.git",
    "directory": "packages/node/core"
  },
  "type": "module",
  "main": "./index.cjs",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./register": "./register.js",
    "./jest-environment": "./jest-environment.cjs",
    "./jest-environment-factory": {
      "types": "./jest-environment-factory.d.ts",
      "default": "./jest-environment-factory.cjs"
    },
    "./package.json": "./package.json",
    "./environment": {
      "types": "./environment.d.ts",
      "default": "./environment.cjs"
    }
  },
  "files": [
    "index.js",
    "index.cjs",
    "index.d.ts",
    "register.js",
    "jest-environment.cjs",
    "jest-environment-factory.cjs",
    "jest-environment-factory.d.ts",
    "README.md",
    "NOTICE",
    "environment.cjs",
    "environment.d.ts",
    "fixture-config.cjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\""
  },
  "peerDependencies": {
    "jest-environment-node": ">=29"
  },
  "peerDependenciesMeta": {
    "jest-environment-node": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@pgmem/darwin-arm64": "1.18.0",
    "@pgmem/linux-arm64": "1.18.0",
    "@pgmem/linux-x64": "1.18.0",
    "@pgmem/win32-arm64": "1.18.0",
    "@pgmem/win32-x64": "1.18.0"
  },
  "keywords": [
    "postgresql",
    "postgres",
    "testing",
    "in-memory",
    "prisma",
    "drizzle",
    "typeorm",
    "vitest",
    "jest"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "pg": "^8.23.1"
  }
}
